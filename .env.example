# Equity Intelligence India — copy to .env and adjust. Never commit .env.
# Phase 1 needs NO API keys. Future paid/licensed providers must read their keys from here.

# Storage (relative paths are resolved from the project root)
EII_DATA_DIR=data
# EII_DB_PATH=data/equity_research.db
# EII_EXCEL_PATH=data/Equity_Intelligence_India.xlsx
# EII_BACKUP_DIR=data/backups
# EII_LOG_DIR=logs
EII_LOG_LEVEL=INFO
EII_MAX_BACKUPS=20

# Data providers
EII_ENABLE_NSE_FILINGS=true
EII_NSE_MIN_INTERVAL_SECONDS=1.0
EII_NSE_LISTING_TTL_HOURS=12
EII_ENABLE_YFINANCE=true
EII_REFERENCE_CACHE_HOURS=24
EII_HTTP_TIMEOUT_SECONDS=20

# Example placeholder for a future licensed provider (not used yet)
# EII_EXAMPLE_PROVIDER_API_KEY=your-key-here
